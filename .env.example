# Copy to .env and edit.

# Path to the active event config (defaults to config/event.yaml)
EVENT_CONFIG=config/event.yaml

# SQLite database file
DB_PATH=commander.db

# Shared passcode for /entry and /admin (session auth)
TRACKER_PASSCODE=change-me

# Secret for signing session cookies (generate: python -c "import secrets;print(secrets.token_hex(32))")
SESSION_SECRET=change-me
