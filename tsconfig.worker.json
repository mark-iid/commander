{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // No node types on purpose. The Worker runs without nodejs_compat, so a
    // `node:` import is a deploy-time failure; this makes it a typecheck
    // failure instead, which is a great deal cheaper to find.
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  // Only worker/. The shared modules the Worker imports are checked anyway,
  // because TypeScript follows imports, while shared's own tests stay in
  // tsconfig.shared.json where node types exist.
  "include": ["worker"]
}
